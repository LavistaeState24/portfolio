Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1) Force HTTPS + non-www
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^scalixomedia\.com$ [NC]
    RewriteRule ^ https://scalixomedia.com%{REQUEST_URI} [R=301,L,NE]

    # 2) Redirect old .html URLs to clean URLs (/about.html -> /about)
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # 3) Special case: /faq -> Faq.html (file name has a capital F)
    RewriteRule ^faq/?$ Faq.html [NC,L]

    # 4) Clean URLs: /services or /services/ -> services.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
